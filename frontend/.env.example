# Backend API URL. Leave unset in production to call the API at the same
# origin (relative /api) — only set this for local dev against a backend
# running elsewhere, or if frontend and backend are on different domains.
REACT_APP_API_URL=http://localhost:5000

# The real deployed domain (no trailing slash), used for canonical/OG tags
# and structured data. Required for correct SEO metadata in production.
REACT_APP_SITE_URL=https://yourdomain.com

# Google AdSense Publisher ID (get from adsense.google.com)
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Leave empty to disable AdSense entirely (placeholder boxes render instead).
REACT_APP_ADSENSE_CLIENT=

# AdSense Ad Slot IDs (get from your AdSense dashboard after approval)
REACT_APP_AD_SLOT_TOP=
REACT_APP_AD_SLOT_BOTTOM=

# Adsterra zone key. Leave empty to disable Adsterra entirely.
REACT_APP_ADSTERRA_KEY=
